        }
    ],
    "steps": [
        {
            "step_number": 1,
            "title": "Shower Door Wheels",
            "step_url": "https://www.ifixit.com/Guide/Bathroom+Drawer+Slide+Replacement/<#s266600>",
            "instructions": [
                "Before starting, remove the existing sliders and brackets by unscrewing the screws in a counterclockwise direction."
            ],
            "images": [
                {
                    "original": "https://guide-images.cdn.ifixit.com/igi/MdeqeGcghNTKFw1N.medium",
                    "thumbnail": ""
                },
                {
