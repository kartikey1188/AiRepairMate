    "steps": [
        {
            "step_number": 1,
            "title": "Bridge",
            "instruction": [
                "Remove the guitar strings.",
                "Use a paper towel to remove any dust and debris from the neck of the guitar."
            ],
            "image_urls": [
                "https://guide-images.cdn.ifixit.com/igi/bcu52nPGljMZ2N6X.medium",
                "https://guide-images.cdn.ifixit.com/igi/wvnH1aJPwV22eNur.medium"
            ],
            "thumbnails": [
                "https://guide-images.cdn.ifixit.com/igi/bcu52nPGljMZ2N6X.200x150",
                "https://guide-images.cdn.ifixit.com/igi/wvnH1aJPwV22eNur.200x150"
            ],
            "edit_link": "https://www.ifixit.com/Guide/Acoustic+Guitar+Bridge+Replacement/</Guide/edit/137173/273203>",
            "add_comment_link": "https://www.ifixit.com/Guide/Acoustic+Guitar+Bridge+Replacement/<#comment>"
        },
        {
            "step_number": 2,
            "instruction": [
                "Apply a warm heating pad to the bridge to loosen the glue."
            ],
            "image_urls": [
                "https://guide-images.cdn.ifixit.com/igi/ZaOeoPS22tZb2qfU.medium"
            ],
            "edit_link": "https://www.ifixit.com/Guide/Acoustic+Guitar+Bridge+Replacement/</Guide/edit/137173/273204>",
            "add_comment_link": "https://www.ifixit.com/Guide/Acoustic+Guitar+Bridge+Replacement/<#comment>"
        },
        {
            "step_number": 3,
            "instruction": [
                "Carefully remove the bridge of the guitar with a putty knife or something with a thin dull blade.",
                "Be careful to not scratch the finish of the guitar."
            ],
            "edit_link": "https://www.ifixit.com/Guide/Acoustic+Guitar+Bridge+Replacement/</Guide/edit/137173/273205>",
            "add_comment_link": "https://www.ifixit.com/Guide/Acoustic+Guitar+Bridge+Replacement/<#comment>"
        },
        {
            "step_number": 4,
            "instruction": [
                "Carefully remove any excess glue or debris on the body of the guitar from the old bridge."
            ],
            "edit_link": "https://www.ifixit.com/Guide/Acoustic+Guitar+Bridge+Replacement/</Guide/edit/137173/273206>",
            "add_comment_link": "https://www.ifixit.com/Guide/Acoustic+Guitar+Bridge+Replacement/<#comment>"
        },
        {
            "step_number": 5,
            "instruction": [
                "Apply wood glue to the new bridge and attach it to where the old one used to be."
            ],
            "edit_link": "https://www.ifixit.com/Guide/Acoustic+Guitar+Bridge+Replacement/</Guide/edit/137173/273207>",
            "add_comment_link": "https://www.ifixit.com/Guide/Acoustic+Guitar+Bridge+Replacement/<#comment>"
        },
        {
            "step_number": 6,
            "instruction": [
                "Use a C-clamp to gently clamp the bridge to the body of the guitar."
            ],
            "edit_link": "https://www.ifixit.com/Guide/Acoustic+Guitar+Bridge+Replacement/</Guide/edit/137173/273208>",
            "add_comment_link": "https://www.ifixit.com/Guide/Acoustic+Guitar+Bridge+Replacement/<#comment>"
        },
        {
            "step_number": 7,
            "instruction": [
                "Wait and let the glue dry.",
                "Time will very based on what glue you use, but to be safe, let it sit for at least 12 hours."
            ],
            "edit_link": "https://www.ifixit.com/Guide/Acoustic+Guitar+Bridge+Replacement/</Guide/edit/137173/273209>",
            "add_comment_link": "https://www.ifixit.com/Guide/Acoustic+Guitar+Bridge+Replacement/<#comment>"
        },
        {
            "step_number": 8,
            "instruction": [
                "Remove the clamp after glue has dried."
            ],
            "edit_link": "https://www.ifixit.com/Guide/Acoustic+Guitar+Bridge+Replacement/</Guide/edit/137173/273210>",
            "add_comment_link": "https://www.ifixit.com/Guide/Acoustic+Guitar+Bridge+Replacement/<#comment>"
        },
        {
            "step_number": 9,
            "instruction": [
                "Restring the guitar."
            ],
            "edit_link": "https://www.ifixit.com/Guide/Acoustic+Guitar+Bridge+Replacement/</Guide/edit/137173/273211>",
            "add_comment_link": "https://www.ifixit.com/Guide/Acoustic+Guitar+Bridge+Replacement/<#comment>"
        },
        {
            "step_number": 10,
            "instruction": [
                "Play!"
            ],
