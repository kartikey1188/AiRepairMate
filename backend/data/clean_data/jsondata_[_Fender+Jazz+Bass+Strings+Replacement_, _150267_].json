    "steps": [
        {
            "step_number": 1,
            "title": "Strings",
            "images": [
                "https://guide-images.cdn.ifixit.com/igi/PZ13AvuKrNWgu5Ff.medium",
                "https://guide-images.cdn.ifixit.com/igi/XgALmq1fPmq2bEUU.medium"
            ],
            "thumbnails": [
                "https://guide-images.cdn.ifixit.com/igi/PZ13AvuKrNWgu5Ff.200x150",
                "https://guide-images.cdn.ifixit.com/igi/XgALmq1fPmq2bEUU.200x150"
            ],
            "description": "Loosen the strings by turning the tuning pegs.",
            "edit_link": "https://www.ifixit.com/Guide/Fender+Jazz+Bass+Strings+Replacement//Guide/edit/166118/349529",
            "add_comment_link": "https://www.ifixit.com/Guide/Fender+Jazz+Bass+Strings+Replacement/",
            "links": []
        },
        {
            "step_number": 2,
            "title": null,
            "images": [
                "https://guide-images.cdn.ifixit.com/igi/pFMnfQyLYCbKjFbj.medium",
                "https://guide-images.cdn.ifixit.com/igi/rrXWNFVHDVSKMXbN.medium"
            ],
            "thumbnails": [
                "https://guide-images.cdn.ifixit.com/igi/pFMnfQyLYCbKjFbj.200x150",
                "https://guide-images.cdn.ifixit.com/igi/rrXWNFVHDVSKMXbN.200x150"
            ],
            "description": "Once the strings are loose, remove them from the tuning pegs.\nIf you prefer, you can also cut the strings off.",
            "edit_link": "https://www.ifixit.com/Guide/Fender+Jazz+Bass+Strings+Replacement//Guide/edit/166118/349530",
            "add_comment_link": "https://www.ifixit.com/Guide/Fender+Jazz+Bass+Strings+Replacement/",
            "links": []
        },
        {
            "step_number": 3,
            "title": null,
            "image": null,
            "description": "Reach under the bridge to pull out the end of each string.",
            "edit_link": "https://www.ifixit.com/Guide/Fender+Jazz+Bass+Strings+Replacement//Guide/edit/166118/349531",
            "add_comment_link": "https://www.ifixit.com/Guide/Fender+Jazz+Bass+Strings+Replacement/",
            "links": []
        },
        {
            "step_number": 4,
            "title": null,
            "image": null,
            "description": "Insert the end of the string with no knob on the bottom through the bridge first.\nPull each string through to the top of the neck.",
            "edit_link": "https://www.ifixit.com/Guide/Fender+Jazz+Bass+Strings+Replacement//Guide/edit/166118/349532",
            "add_comment_link": "https://www.ifixit.com/Guide/Fender+Jazz+Bass+Strings+Replacement/",
            "links": []
        },
        {
            "step_number": 5,
            "title": null,
            "image": null,
            "description": "Insert the strings into the indentations on the nut.\nWrap the strings around the tuning pegs about two times.",
            "edit_link": "https://www.ifixit.com/Guide/Fender+Jazz+Bass+Strings+Replacement//Guide/edit/166118/349534",
            "add_comment_link": "https://www.ifixit.com/Guide/Fender+Jazz+Bass+Strings+Replacement/",
            "links": []
        },
        {
            "step_number": 6,
            "title": null,
            "image": null,
            "description": "Tighten the tuning pegs until the bass is in tune.\nThe standard tuning for a bass is E A D G.\nYou will have excess string hanging off the pegs of the bass.",
            "edit_link": "https://www.ifixit.com/Guide/Fender+Jazz+Bass+Strings+Replacement//Guide/edit/166118/349535",
            "add_comment_link": "https://www.ifixit.com/Guide/Fender+Jazz+Bass+Strings+Replacement/",
            "links": []
        }
    ],
    "conclusion": "After you remove the first string, you will reassemble and continue the process until you have changed all four strings.",
