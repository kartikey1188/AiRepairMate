    "steps": [
        {
            "step_number": 1,
            "title": "Broken Needle",
            "images": [
                {
                    "url": "https://guide-images.cdn.ifixit.com/igi/RMM2RSsMo2QZtNKq.medium",
                    "thumbnail_url": "https://guide-images.cdn.ifixit.com/igi/RMM2RSsMo2QZtNKq.200x150"
                },
                {
                    "url": "https://guide-images.cdn.ifixit.com/igi/qGpNAqGcZxsia6rt.medium",
                    "thumbnail_url": "https://guide-images.cdn.ifixit.com/igi/qGpNAqGcZxsia6rt.200x150"
                },
                {
                    "url": "https://guide-images.cdn.ifixit.com/igi/flhmQX4qh4mYsCSL.medium",
                    "thumbnail_url": "https://guide-images.cdn.ifixit.com/igi/flhmQX4qh4mYsCSL.200x150"
                }
            ],
            "instructions": [
                "Adjust the needle with the handwheel towards you until it is at the highest position, as indicated by the silver thread take-up lever."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/158118/331062",
            "add_comment_url": "https://www.ifixit.com/Guide/Brother+XM3700+Broken+Needle+Replacement/<#>",
            "links": []
        },
        {
            "step_number": 2,
            "title": "",
            "images": [
                {
                    "url": "https://guide-images.cdn.ifixit.com/igi/m5yJ1SWdsEfAZTQP.medium",
                    "thumbnail_url": "https://guide-images.cdn.ifixit.com/igi/m5yJ1SWdsEfAZTQP.200x150"
                },
                {
                    "url": "https://guide-images.cdn.ifixit.com/igi/NJJxfkV4HhxlPFrG.medium",
                    "thumbnail_url": "https://guide-images.cdn.ifixit.com/igi/NJJxfkV4HhxlPFrG.200x150"
                }
            ],
            "instructions": [
                "Unscrew the bolt that holds the needle in place using either the tool that came with your Brother machine, or a small flat object like a coin."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/158118/331067",
            "add_comment_url": "https://www.ifixit.com/Guide/Brother+XM3700+Broken+Needle+Replacement/<#>",
            "links": []
        },
        {
            "step_number": 3,
            "title": "",
            "images": [],
            "instructions": [
                "Remove the broken needle stem from the machine, and dispose of it carefully."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/158118/331072",
            "add_comment_url": "https://www.ifixit.com/Guide/Brother+XM3700+Broken+Needle+Replacement/<#>",
            "links": []
        },
        {
            "step_number": 4,
            "title": "",
            "images": [],
            "instructions": [
                "Unthread the broken needle tip from the thread, and dispose of carefully."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/158118/331074",
            "add_comment_url": "https://www.ifixit.com/Guide/Brother+XM3700+Broken+Needle+Replacement/<#>",
            "links": []
        },
        {
            "step_number": 5,
            "title": "",
            "images": [],
            "instructions": [
                "Select a Brother brand needle, using the needle size that works well with your fabric."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/158118/331075",
            "add_comment_url": "https://www.ifixit.com/Guide/Brother+XM3700+Broken+Needle+Replacement/<#>",
            "links": []
        },
        {
            "step_number": 6,
            "title": "",
            "images": [],
            "instructions": [
                "Insert the needle with the flat side of the stem facing the back of the machine."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/158118/331076",
            "add_comment_url": "https://www.ifixit.com/Guide/Brother+XM3700+Broken+Needle+Replacement/<#>",
            "links": []
        },
        {
            "step_number": 7,
            "title": "",
            "images": [],
            "instructions": [
                "Screw the bolt in first with your fingers and then with the tool until the needle is tightly secured."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/158118/331077",
            "add_comment_url": "https://www.ifixit.com/Guide/Brother+XM3700+Broken+Needle+Replacement/<#>",
            "links": []
        },
        {
            "step_number": 8,
            "title": "",
            "images": [],
            "instructions": [
                "Rethread the needle and pull the thread through the back."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/158118/331079",
            "add_comment_url": "https://www.ifixit.com/Guide/Brother+XM3700+Broken+Needle+Replacement/<#>",
            "links": []
        }
    ],
    "conclusion": "Congratulations! You have successfully replaced your broken needle. Happy sewing!",
