    "steps": [
        {
            "step_number": 1,
            "title": "Face Plate",
            "image_url": "https://guide-images.cdn.ifixit.com/igi/aDinq1CRlSbmudCJ.medium",
            "instructions": [
                "Remove all the selector knob covers by pulling them off."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/12977/44419",
            "comment_count": 1
        },
        {
            "step_number": 2,
            "image_url": "https://guide-images.cdn.ifixit.com/igi/B3pRLtGKy5BYEjpC.medium",
            "instructions": [
                "Using needle nose pliers, remove the washers from the four corner selector knobs."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/12977/44420",
            "comment_count": 1
        },
        {
            "step_number": 3,
            "edit_url": "https://www.ifixit.com/Guide/edit/12977/44421",
            "instructions": [
                "Flip the device over. Using a Philips #2 screw driver, remove the fourteen 10.3 mm black screws holding the back panel in place."
            ],
            "comment_count": 0
        },
        {
            "step_number": 4,
            "edit_url": "https://www.ifixit.com/Guide/edit/12977/44422",
            "instructions": [
                "Carefully flip the device to the front making sure you secure the face plate and the chassis together.",
                "Please use care in following the step above to avoid ripping the ribbon cables connecting the two sides."
            ],
            "comment_count": 0
        },
        {
            "step_number": 5,
            "edit_url": "https://www.ifixit.com/Guide/edit/12977/44423",
            "instructions": [
                "Rotate the device 180 degrees and carefully remove the face plate by slightly lifting the screen side towards you and then sliding the bottom out from under the keys.",
                "Use care when doing the step above so that the ribbon connectors which connect the top of the chassis to the top of the face plate are not damaged."
            ],
            "comment_count": 0
        },
        {
            "step_number": 6,
            "title": "LCD",
            "edit_url": "https://www.ifixit.com/Guide/edit/12977/44433",
            "instructions": [
                "Using a Phillips #00 screwdriver, remove the four 8.9 mm screws."
            ],
            "comment_count": 0
        },
        {
            "step_number": 7,
            "edit_url": "https://www.ifixit.com/Guide/edit/12977/44438",
            "instructions": [
                "Using a Phillips #2 screwdriver, remove the one 9.8mm screw holding down the ground wire."
            ],
            "comment_count": 0
        },
        {
            "step_number": 8,
            "edit_url": "https://www.ifixit.com/Guide/edit/12977/44439",
            "instructions": [
                "Using two plastic opening tools, slide the black locking mechanism on the ZIF connector towards you. This will remove the ribbon cable connecting the motherboard to the screen."
            ],
            "comment_count": 0
        },
        {
            "step_number": 9,
            "edit_url": "https://www.ifixit.com/Guide/edit/12977/44931",
            "instructions": [
                "Lift the screen from either side, removing it from the board."
            ],
            "comment_count": 0
        }
    ],
    "conclusion": "To reassemble the display, follow these instructions in reverse order.",
