    "introduction": "Educating the user how to replace the batteries of the screen display to properly function the device.",
    "steps": [
        {
            "step_number": 1,
            "title": "Screen Display Battery",
            "text": "Remove the battery compartment lid by lifting upward.",
            "image": "https://guide-images.cdn.ifixit.com/igi/TCdEtPVoMRoV4xTb.medium",
            "image_links": [
                "https://guide-images.cdn.ifixit.com/igi/TCdEtPVoMRoV4xTb.200x150",
                "https://guide-images.cdn.ifixit.com/igi/egtbQh2urhSQTyug.200x150",
                "https://guide-images.cdn.ifixit.com/igi/aJCdKmJVwc533PD1.200x150"
            ],
            "edit_link": "https://www.ifixit.com/Guide/edit/72316/144507",
            "comment_links": [],
            "additional_images": [
                "https://guide-images.cdn.ifixit.com/igi/egtbQh2urhSQTyug.medium",
                "https://guide-images.cdn.ifixit.com/igi/aJCdKmJVwc533PD1.medium"
            ]
        },
        {
            "step_number": 2,
            "title": "",
            "text": "Remove the 3 x AA alkaline batteries from each battery slot.",
            "image": "https://guide-images.cdn.ifixit.com/igi/yMyOR5IcFJumOPNQ.medium",
            "image_links": [
                "https://guide-images.cdn.ifixit.com/igi/yMyOR5IcFJumOPNQ.200x150",
                "https://guide-images.cdn.ifixit.com/igi/PQBS2P5BOFgfBeh4.200x150",
                "https://guide-images.cdn.ifixit.com/igi/MM1PmB4WYWJSemBY.200x150"
            ],
            "edit_link": "https://www.ifixit.com/Guide/edit/72316/144509",
            "comment_links": [],
            "additional_images": [
                "https://guide-images.cdn.ifixit.com/igi/PQBS2P5BOFgfBeh4.medium",
                "https://guide-images.cdn.ifixit.com/igi/MM1PmB4WYWJSemBY.medium"
            ]
        },
        {
            "step_number": 3,
            "title": "",
            "text": "Before replacing the batteries pay attention to the position of the **+** and **-** poles on the battery compartment pad.",
            "image_links": [],
            "edit_link": "https://www.ifixit.com/Guide/edit/72316/144508",
            "comment_links": []
        }
    ],
    "conclusion": {
        "text": "To reassemble your device, follow these instructions in reverse order.",
