    "steps": [
        {
            "step_number": 1,
            "title": "20-inch Sediment Pre-Filter",
            "instructions": [
                "Turn off the water supply by turning the water valve(s) to be horizontal, or perpendicular to the water pipe.",
                "You may have one or two valves depending on the installation of your system."
            ],
            "image_url": "https://guide-images.cdn.ifixit.com/igi/aAvJLAkJJgrRaSaE.medium",
            "additional_images": [
                "https://guide-images.cdn.ifixit.com/igi/aAvJLAkJJgrRaSaE.200x150",
                "https://guide-images.cdn.ifixit.com/igi/6NSODZYKfF4SBeLy.200x150"
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/153794/319516",
            "add_comment_url": "https://www.ifixit.com/Guide/Aquasana+F-300R+300000+Gallon+Whole+House+Water+Filtration+System+20-Inch+Sediment+Pre-Filter+Replacement/#",
            "links": []
        },
        {
            "step_number": 2,
            "instructions": [
                "Press the black pressure release button on top of the filter housing.",
                "Hold the button down for 5 seconds."
            ],
            "image_url": "https://guide-images.cdn.ifixit.com/igi/DhSEgyMfohNTY43a.medium",
            "additional_images": [
                "https://guide-images.cdn.ifixit.com/igi/DhSEgyMfohNTY43a.200x150",
                "https://guide-images.cdn.ifixit.com/igi/i5LPBZEMyuewJYif.200x150"
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/153794/319517",
            "add_comment_url": "https://www.ifixit.com/Guide/Aquasana+F-300R+300000+Gallon+Whole+House+Water+Filtration+System+20-Inch+Sediment+Pre-Filter+Replacement/#",
            "links": []
        },
        {
            "step_number": 3,
            "instructions": [
                "Unscrew the filter housing canister clockwise with a water filter housing wrench."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/153794/319518",
            "add_comment_url": "https://www.ifixit.com/Guide/Aquasana+F-300R+300000+Gallon+Whole+House+Water+Filtration+System+20-Inch+Sediment+Pre-Filter+Replacement/#",
            "links": []
        },
        {
            "step_number": 4,
            "instructions": [
                "Remove the dirty pre-filter and dispose of it."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/153794/319519",
            "add_comment_url": "https://www.ifixit.com/Guide/Aquasana+F-300R+300000+Gallon+Whole+House+Water+Filtration+System+20-Inch+Sediment+Pre-Filter+Replacement/#",
            "links": []
        },
        {
            "step_number": 5,
            "instructions": [
                "Wash the filter housing canister with dish soap and water.",
                "You may need a long-handled cleaning brush to scrub off dirt and debris.",
                "Rinse and dry the filter housing canister."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/153794/319520",
            "add_comment_url": "https://www.ifixit.com/Guide/Aquasana+F-300R+300000+Gallon+Whole+House+Water+Filtration+System+20-Inch+Sediment+Pre-Filter+Replacement/#",
            "links": []
        },
        {
            "step_number": 6,
            "instructions": [
                "Remove the O-ring from the housing canister."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/153794/319521",
            "add_comment_url": "https://www.ifixit.com/Guide/Aquasana+F-300R+300000+Gallon+Whole+House+Water+Filtration+System+20-Inch+Sediment+Pre-Filter+Replacement/#",
            "links": []
        },
        {
            "step_number": 7,
            "instructions": [
                "Clean off old grease on the O-ring with a towel."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/153794/319522",
            "add_comment_url": "https://www.ifixit.com/Guide/Aquasana+F-300R+300000+Gallon+Whole+House+Water+Filtration+System+20-Inch+Sediment+Pre-Filter+Replacement/#",
            "links": []
        },
        {
            "step_number": 8,
            "instructions": [
                "Replace the O-ring.",
                "Apply Vaseline or lube around the seal."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/153794/319523",
            "add_comment_url": "https://www.ifixit.com/Guide/Aquasana+F-300R+300000+Gallon+Whole+House+Water+Filtration+System+20-Inch+Sediment+Pre-Filter+Replacement/#",
            "links": []
        },
        {
            "step_number": 9,
            "instructions": [
                "Place the new pre-filter in the center of the filter housing canister."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/153794/319524",
            "add_comment_url": "https://www.ifixit.com/Guide/Aquasana+F-300R+300000+Gallon+Whole+House+Water+Filtration+System+20-Inch+Sediment+Pre-Filter+Replacement/#",
            "links": []
        },
        {
            "step_number": 10,
            "instructions": [
                "Screw the filter housing canister counter-clockwise with your hands."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/153794/319525",
            "add_comment_url": "https://www.ifixit.com/Guide/Aquasana+F-300R+300000+Gallon+Whole+House+Water+Filtration+System+20-Inch+Sediment+Pre-Filter+Replacement/#",
            "links": []
        },
        {
            "step_number": 11,
            "instructions": [
                "Tighten the filter housing canister with the filter wrench."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/153794/319526",
            "add_comment_url": "https://www.ifixit.com/Guide/Aquasana+F-300R+300000+Gallon+Whole+House+Water+Filtration+System+20-Inch+Sediment+Pre-Filter+Replacement/#",
            "links": []
        },
        {
            "step_number": 12,
            "instructions": [
                "Turn on the water supply by turning the water valve(s) to be vertical, or parallel to the water pipe."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/153794/319527",
            "add_comment_url": "https://www.ifixit.com/Guide/Aquasana+F-300R+300000+Gallon+Whole+House+Water+Filtration+System+20-Inch+Sediment+Pre-Filter+Replacement/#",
            "links": []
        },
        {
            "step_number": 13,
            "instructions": [
                "Run water in a sink or tub for 1-2 minutes to flush out the system and remove any air in the pipes."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/153794/319538",
            "add_comment_url": "https://www.ifixit.com/Guide/Aquasana+F-300R+300000+Gallon+Whole+House+Water+Filtration+System+20-Inch+Sediment+Pre-Filter+Replacement/#",
            "links": []
        }
