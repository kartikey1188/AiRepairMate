    "steps": [
        {
            "step_number": 1,
            "title": "Cabinet Magnet Catch",
            "step_url": "https://www.ifixit.com/Guide/Cabinet+Magnetic+Catch+Replacement/<#s290728>",
            "instructions": [
                "Remove two screws from the the old magnetic catch using a Phillips #0 screwdriver.",
                "Remove the magnetic catch from the shelf.",
                "It is recommended you use a stubby screwdriver since you will be dealing with tight spaces of the cabinet shelf."
            ],
            "images": [
                {
                    "original": "https://guide-images.cdn.ifixit.com/igi/hgVV5xtcghGMyk4B.medium",
                    "thumbnail": "https://guide-images.cdn.ifixit.com/igi/hgVV5xtcghGMyk4B.200x150"
                },
                {
                    "original": "https://guide-images.cdn.ifixit.com/igi/kpRAQEKthWxtSHIi.medium",
                    "thumbnail": "https://guide-images.cdn.ifixit.com/igi/kpRAQEKthWxtSHIi.200x150"
                }
            ],
            "edit_url": "https://www.ifixit.com/Guide/Cabinet+Magnetic+Catch+Replacement/</Guide/edit/143698/290728>",
            "comments_section": {
                "add_comment_url": null,
                "max_length": 1024
            }
        },
        {
            "step_number": 2,
            "title": "",
            "step_url": "https://www.ifixit.com/Guide/Cabinet+Magnetic+Catch+Replacement/<#s290729>",
            "instructions": [
                "Remove the screws securing the plates to the cabinet doors using a Phillips #0 screwdriver. Remove the plates.",
                "Do this on the both sides."
            ],
            "images": [
                {
                    "original": "https://guide-images.cdn.ifixit.com/igi/OxgGvgWEGhS3gnJI.medium",
                    "thumbnail": ""
                }
            ],
            "edit_url": "https://www.ifixit.com/Guide/Cabinet+Magnetic+Catch+Replacement/</Guide/edit/143698/290729>",
            "comments_section": {
                "add_comment_url": null,
                "max_length": 1024
            }
        },
        {
            "step_number": 3,
            "title": "",
            "step_url": "https://www.ifixit.com/Guide/Cabinet+Magnetic+Catch+Replacement/<#s290730>",
            "instructions": [
                "Place the new magnetic catch on the center of the shelf cabinet.",
                "Ensure it is adjusted carefully by moving its width halfway out of the cabinet and aligned on each side."
            ],
            "images": [],
            "edit_url": "https://www.ifixit.com/Guide/Cabinet+Magnetic+Catch+Replacement/</Guide/edit/143698/290730>",
            "comments_section": {
                "add_comment_url": null,
                "max_length": 1024
            }
        },
        {
            "step_number": 4,
            "title": "",
            "step_url": "https://www.ifixit.com/Guide/Cabinet+Magnetic+Catch+Replacement/<#s290731>",
            "instructions": [
                "With your graphite pencil, mark the location of the screw holes so you know exactly where you placed it in case you get lost."
            ],
            "images": [],
            "edit_url": "https://www.ifixit.com/Guide/Cabinet+Magnetic+Catch+Replacement/</Guide/edit/143698/290731>",
            "comments_section": {
                "add_comment_url": null,
                "max_length": 1024
            }
        },
        {
            "step_number": 5,
            "title": "",
            "step_url": "https://www.ifixit.com/Guide/Cabinet+Magnetic+Catch+Replacement/<#s290732>",
            "instructions": [
                "Screw in two 10 mm screws on the new magnetic catch using a Phillips #0 screwdriver to secure it in place.",
                "Ensure that you are maintaining alignment of the magnetic catch with the help of Step 4. Otherwise, you will repeat Step 3.",
                "You may reuse the old screws from the removal in Step 1 to install the new magnetic catch."
            ],
            "images": [],
            "edit_url": "https://www.ifixit.com/Guide/Cabinet+Magnetic+Catch+Replacement/</Guide/edit/143698/290732>",
            "comments_section": {
                "add_comment_url": null,
                "max_length": 1024
            }
        },
        {
            "step_number": 6,
            "title": "",
            "step_url": "https://www.ifixit.com/Guide/Cabinet+Magnetic+Catch+Replacement/<#s290733>",
            "instructions": [
                "Close the cabinet and mark down the side of the cabinet door using a graphite pencil.",
                "Do this on the other side."
            ],
            "images": [],
            "edit_url": "https://www.ifixit.com/Guide/Cabinet+Magnetic+Catch+Replacement/</Guide/edit/143698/290733>",
            "comments_section": {
                "add_comment_url": null,
                "max_length": 1024
            }
        },
        {
            "step_number": 7,
            "title": "",
            "step_url": "https://www.ifixit.com/Guide/Cabinet+Magnetic+Catch+Replacement/<#s290734>",
            "instructions": [
                "Screw in one 5mm screw on the new magnetic plate using a Phillips #0 screwdriver to secure it in place on one side of the cabinet door.",
                "Ensure that you are maintaining alignment of the magnetic plates with the help of Step 6 and old screw holes.",
                "Do this step on the other side with the second 5mm screw.",
                "You may reuse the old screws from the removal in Step 2 to install the new magnetic plates."
            ],
            "images": [],
            "edit_url": "https://www.ifixit.com/Guide/Cabinet+Magnetic+Catch+Replacement/</Guide/edit/143698/290734>",
            "comments_section": {
                "add_comment_url": null,
                "max_length": 1024
            }
        },
        {
            "step_number": 8,
            "title": "",
            "step_url": "https://www.ifixit.com/Guide/Cabinet+Magnetic+Catch+Replacement/<#s290735>",
            "instructions": [
                "Test the cabinet magnetic catch by closing it.",
                "You are finished when the cabinet stays closed after letting your hands go."
            ],
