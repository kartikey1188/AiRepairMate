                    "url": "/Guide/edit/148371/304652"
                }
            ]
        },
        {
            "step_number": 3,
            "title": "",
            "instructions": [
                "Flip the mechanism upside down so that the groove is facing up."
            ],
            "links": [
                {
                    "text": "Edit",
                    "url": "/Guide/edit/148371/304654"
                }
            ]
        },
        {
            "step_number": 4,
            "title": "",
            "instructions": [
                "Use the top of the lighter housing to twist the cap loose.",
                "Set aside the lighter once it becomes loose enough to do it by hand."
            ],
            "links": [
                {
                    "text": "Edit",
                    "url": "/Guide/edit/148371/304656"
                }
            ]
        },
        {
            "step_number": 5,
            "title": "",
            "instructions": [
                "Pull on the cap and the spring will come out with it."
            ],
            "links": [
                {
                    "text": "Edit",
                    "url": "/Guide/edit/148371/304660"
                }
            ]
        },
        {
            "step_number": 6,
            "title": "",
            "instructions": [
                "Flip the mechanism and tap on the bottom so that the old flint falls out if there is any left.",
                "Use a hard surface if necessary."
            ],
            "links": [
                {
                    "text": "Edit",
                    "url": "/Guide/edit/148371/304661"
                }
            ]
        },
        {
            "step_number": 7,
            "title": "",
            "instructions": [
                "Take a new flint and drop it down the tube."
            ],
