    "steps": [
        {
            "step_number": 1,
            "step_title": "Coin Display Case Glass Attachment",
            "images": [
                {
                    "url": "https://guide-images.cdn.ifixit.com/igi/1SR6d5kkePydrJQc.medium",
                    "alt_text": "Coin Display Case Glass Attachment, Coin Display Case Glass Attachment: step 1, image 1 of 2"
                },
                {
                    "url": "https://guide-images.cdn.ifixit.com/igi/IPNNBkMEcjTSeAMl.medium",
                    "alt_text": "Coin Display Case Glass Attachment, Coin Display Case Glass Attachment: step 1, image 2 of 2"
                }
            ],
            "text": "Clean the display case thoroughly with glass cleaner and a paper towel.",
            "links": [
                {
                    "type": "edit",
                    "url": "https://www.ifixit.com/Guide/edit/61286/128092"
                }
            ]
        },
        {
            "step_number": 2,
            "step_title": null,
            "images": [
                {
                    "url": "https://guide-images.cdn.ifixit.com/igi/RLWtLhnaYbuGojm1.medium",
                    "alt_text": "Coin Display Case Glass Attachment: step 2, image 1 of 1"
                }
            ],
            "text": "Gently pry the glass away from the glue on the frame. Be careful not to shatter the glass.",
            "links": [
                {
                    "type": "edit",
                    "url": "https://www.ifixit.com/Guide/edit/61286/128093"
                }
            ]
        },
        {
            "step_number": 3,
            "step_title": null,
            "images": [],
            "text": "Apply a thin, solid line of a strong adhesive, such as Gorilla Glue, to the entire inner border of the display case where the glass attaches.",
            "links": [
                {
                    "type": "edit",
                    "url": "https://www.ifixit.com/Guide/edit/61286/128097"
                }
            ]
        },
        {
            "step_number": 4,
            "step_title": null,
            "images": [],
            "text": "Gently, but firmly, press the glass back into the felt lining. Run your finger with firm pressure along the entire lining of the glass two times.",
            "links": [
                {
                    "type": "edit",
                    "url": "https://www.ifixit.com/Guide/edit/61286/128098"
                }
            ]
        },
        {
            "step_number": 5,
            "step_title": null,
            "images": [],
            "text": "Allow the glue to set for 2-4 hours for the strongest bond.\nKeep the case in the upright position while the glue sets.\nDo**not** close or shut the case during the drying/setting process.",
            "links": [
                {
                    "type": "edit",
                    "url": "https://www.ifixit.com/Guide/edit/61286/130325"
                }
            ]
        }
    ],
    "conclusion": "Allow the glass and glue to bond for at least 6 hours before using the case.",
