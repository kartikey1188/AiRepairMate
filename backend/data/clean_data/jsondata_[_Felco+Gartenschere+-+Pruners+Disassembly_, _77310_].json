        "title": "Felco Gartenschere - Pruners Disassembly",
        "contributors_link": "https://www.ifixit.com/Guide/history/77310",
        "last_updated": "February 3, 2021",
        "estimated_time": "15 minutes",
        "difficulty": "Very easy",
        "community_guide": true,
        "introduction": "These scissors require a little maintenance. The blade must be sharpened, rust marks removed and the joint lubricated."
    },
    "tools": [
        {
            "name": "Gabelschlüsselset",
