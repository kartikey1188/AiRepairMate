    "introduction": "Sewing needles can become dull or damaged and need replacement. Fortunately, replacing the needle is quick and easy, and only requires a few simple steps.",
    "steps": [
        {
            "step_number": 1,
            "title": "Needle",
            "text": "Adjust the needle to the top of its stroke using the hand wheel.",
            "image": "https://guide-images.cdn.ifixit.com/igi/DJEaCHcEMYt2OdTD.medium",
            "image_links": [],
            "edit_link": "https://www.ifixit.com/Guide/edit/22758/59605",
            "comment_links": []
        },
        {
            "step_number": 2,
            "title": "",
            "text": "Loosen the needle by turning the knob counterclockwise.",
            "image": "https://guide-images.cdn.ifixit.com/igi/bHLkuuwJBW1Q33Se.medium",
            "image_links": [],
            "edit_link": "https://www.ifixit.com/Guide/edit/22758/59581",
            "comment_links": []
        },
        {
            "step_number": 3,
            "title": "",
            "text": "Remove the needle.",
            "image_links": [],
            "edit_link": "https://www.ifixit.com/Guide/edit/22758/59583",
            "comment_links": []
        }
    ],
    "conclusion": {
        "text": "To reassemble your device, follow these instructions in reverse order.",
