    "introduction": "The bobbin is crucial to a functional sewing machine! This guide will take you through the steps to replace it.",
    "steps": [
        {
            "step_number": 1,
            "title": "Bobbin",
            "text": "Pull off the storage area beneath the needle.",
            "image": "https://guide-images.cdn.ifixit.com/igi/hrxGYM3QqywJKZQJ.medium",
            "image_links": [
                "https://guide-images.cdn.ifixit.com/igi/hrxGYM3QqywJKZQJ.200x150",
                "https://guide-images.cdn.ifixit.com/igi/yn1kmGl5AEHHmakP.200x150"
            ],
            "edit_link": "https://www.ifixit.com/Guide/edit/22731/59512",
            "comment_links": [],
            "additional_images": [
                "https://guide-images.cdn.ifixit.com/igi/yn1kmGl5AEHHmakP.medium"
            ]
        },
        {
            "step_number": 2,
            "title": "",
            "text": "Flip open the tab below the needle.",
            "image": "https://guide-images.cdn.ifixit.com/igi/OIO6M3QjLdJnPyNP.medium",
            "image_links": [],
            "edit_link": "https://www.ifixit.com/Guide/edit/22731/59513",
            "comment_links": []
        },
        {
            "step_number": 3,
            "title": "",
            "text": "Pull on the end of the rectangular tab on the bobbin case. This will pop off the bobbin and bobbin case.",
            "image_links": [],
            "edit_link": "https://www.ifixit.com/Guide/edit/22731/59514",
            "comment_links": []
        },
        {
            "step_number": 4,
            "title": "",
            "text": "Pull the bobbin out of the bobbin case.",
            "image_links": [],
            "edit_link": "https://www.ifixit.com/Guide/edit/22731/59515",
            "comment_links": []
        }
    ],
    "conclusion": {
        "text": "To reassemble your device, follow these instructions in reverse order.",
