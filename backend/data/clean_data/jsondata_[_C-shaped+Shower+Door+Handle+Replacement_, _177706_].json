{
    "metadata": {
        "title": "C-shaped Shower Door Handle Replacement",
        "last_updated": "January 15, 2025",
        "estimated_time": "10 - 15 minutes",
        "difficulty": "Easy",
        "featured_student_guide": true,
        "introduction": "This fast-fix teaches you how to repair a loose or \"broken\" C-shaped shower door handle, also called “back to back” or \"C-pulls.\"\nMany C-shaped handles are secured to the shower door by flat plastic washers. When these washers shift or warp, they can loosen the handle over time, causing it to eventually fall completely off the door.\nThis repair can seem intimidating because the handle design appears to be soldered on, and the installation screws are not clearly visible. However, the repair is quite quick and easy with some simple tools and inexpensive parts.\n**Note:** Some shower handles require different sizes of washers and may have slightly larger or smaller installation (socket head cap) screws. While this fix specifies a 2.5 mm Allen wrench and 3/4\" plastic washers, you should confirm the size of the tools and parts you will need for your specific shower handle before beginning."
    },
    "parts": [
        {
            "name": "3/4\" clear flat vinyl replacement washers",
            "url": "https://www.amazon.com/dp/B09TZSXK3N?ref=ppx_yo2ov_dt_b_fed_asin_title&tag=ifixitam-20",
            "affiliate_link": true,
            "available_for_sale": "https://www.amazon.com/dp/B09TZSXK3N?ref=ppx_yo2ov_dt_b_fed_asin_title&tag=ifixitam-20",
            "view_link": "https://www.amazon.com/dp/B09TZSXK3N?ref=ppx_yo2ov_dt_b_fed_asin_title&tag=ifixitam-20"
        }
    ],
    "tools": [
        {
            "name": "Phillips #2 Screwdriver",
            "url": "https://www.ifixit.com/products/6-in-1-screwdriver",
            "image_url": "https://cart-products.cdn.ifixit.com/cart-products/LYcK13TjejldWD5Y.thumbnail",
            "price": "$6.99",
            "add_to_cart": true
        },
        {
            "name": "Allen Wrench Set",
            "url": "https://www.amazon.com/CRAFTSMAN-Universal-Allen-Wrench-CMHT26028/dp/B0CDYT8LVV/ref=psdc_328182011_t2_B0776C2D6H?th=1&tag=ifixitam-20",
            "affiliate_link": true,
            "available_for_sale": "https://www.amazon.com/CRAFTSMAN-Universal-Allen-Wrench-CMHT26028/dp/B0CDYT8LVV/ref=psdc_328182011_t2_B0776C2D6H?th=1&tag=ifixitam-20",
            "view_link": "https://www.amazon.com/CRAFTSMAN-Universal-Allen-Wrench-CMHT26028/dp/B0CDYT8LVV/ref=psdc_328182011_t2_B0776C2D6H?th=1&tag=ifixitam-20"
        }
    ],
    "steps": [
        {
            "step_number": 1,
            "title": "C-shaped Shower Door Handle",
            "instructions": [
                "Locate the socket head cap screw on the bottom arm of one door handle.",
                "Only one handle will have the cap screws—one on the top and one on the bottom arm.",
                "Insert the Allen wrench into the cap screw hole.",
                "Rotate the Allen wrench counterclockwise to loosen the screw."
            ],
            "image_url": "https://guide-images.cdn.ifixit.com/igi/miHrfU2SsOUxbi1c.medium",
            "additional_images": [
                "https://guide-images.cdn.ifixit.com/igi/miHrfU2SsOUxbi1c.200x150",
                "https://guide-images.cdn.ifixit.com/igi/eL6MgdvT4C3RhrGS.200x150",
                "https://guide-images.cdn.ifixit.com/igi/oqxZRR2XdlWVrsgt.200x150"
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/177706/377986",
            "add_comment_url": "https://www.ifixit.com/Guide/C-shaped+Shower+Door+Handle+Replacement/#",
            "links": []
        },
        {
            "step_number": 2,
            "instructions": [
                "Once the screw has been loosened, gently pull the handle away from the door."
            ],
            "image_url": "https://guide-images.cdn.ifixit.com/igi/4Pa3J112cQWPxJTU.medium",
            "additional_images": [
                "https://guide-images.cdn.ifixit.com/igi/4Pa3J112cQWPxJTU.200x150",
                "https://guide-images.cdn.ifixit.com/igi/ap4jvAfA4MZOxieS.200x150"
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/177706/377987",
            "add_comment_url": "https://www.ifixit.com/Guide/C-shaped+Shower+Door+Handle+Replacement/#",
            "links": []
        },
        {
            "step_number": 3,
            "instructions": [
                "Repeat steps 1 and 2 for the top of the handle.",
                "Carefully remove the handle."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/177706/377988",
            "add_comment_url": "https://www.ifixit.com/Guide/C-shaped+Shower+Door+Handle+Replacement/#",
            "links": []
        },
        {
            "step_number": 4,
            "instructions": [
                "On the remaining handle, insert the Phillips #2 screwdriver into the bottom screw.",
                "Turn the screwdriver counterclockwise to loosen the screw.",
                "Remove the screw cap, screw, and washer.",
                "There may be several parts to the screw and washer set. This example has a brass screw cap, a screw, a larger 1.25\" metal washer and plastic washer, and the interior, 3/4\" plastic washer."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/177706/377989",
            "add_comment_url": "https://www.ifixit.com/Guide/C-shaped+Shower+Door+Handle+Replacement/#",
            "links": []
        },
        {
            "step_number": 5,
            "instructions": [
                "Disassemble the screw and washer set.",
                "Remove the old or damaged interior plastic washer and discard."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/177706/377990",
            "add_comment_url": "https://www.ifixit.com/Guide/C-shaped+Shower+Door+Handle+Replacement/#",
            "links": []
        },
        {
            "step_number": 6,
            "instructions": [
                "Slide the new plastic washer onto the screw.",
                "This may require threading the washer onto the screw if the hole is snug.",
                "After you have threaded the new washer, reassemble the remaining parts of the screw set in reverse order."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/177706/377991",
            "add_comment_url": "https://www.ifixit.com/Guide/C-shaped+Shower+Door+Handle+Replacement/#",
            "links": []
        },
        {
            "step_number": 7,
            "instructions": [
                "Insert the threaded screw set back through the shower door and handle.",
                "Tighten the screw with the Phillips screwdriver, taking care not to overtighten or strip the screw."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/177706/377992",
            "add_comment_url": "https://www.ifixit.com/Guide/C-shaped+Shower+Door+Handle+Replacement/#",
            "links": []
        },
        {
            "step_number": 8,
            "instructions": [
                "Repeat steps 4-7 with the top screw."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/177706/377993",
            "add_comment_url": "https://www.ifixit.com/Guide/C-shaped+Shower+Door+Handle+Replacement/#",
            "links": []
        },
        {
            "step_number": 9,
            "instructions": [
                "Once both screws are tightened, slide the other handle back onto the screws."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/177706/377996",
            "add_comment_url": "https://www.ifixit.com/Guide/C-shaped+Shower+Door+Handle+Replacement/#",
            "links": []
        },
        {
            "step_number": 10,
            "instructions": [
                "Tighten the cap screw on the top part of the handle with the Allen wrench."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/177706/377997",
            "add_comment_url": "https://www.ifixit.com/Guide/C-shaped+Shower+Door+Handle+Replacement/#",
            "links": []
        },
        {
            "step_number": 11,
            "instructions": [
                "Repeat with the bottom cap screw."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/177706/377999",
            "add_comment_url": "https://www.ifixit.com/Guide/C-shaped+Shower+Door+Handle+Replacement/#",
            "links": []
        },
        {
            "step_number": 12,
            "instructions": [
                "Test both sides of the handle by gripping each one and gently pulling them back and forth.",
                "If the handle is properly secure, there should be no movement."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/177706/378001",
            "add_comment_url": "https://www.ifixit.com/Guide/C-shaped+Shower+Door+Handle+Replacement/#",
            "links": []
        }
    ],
