        {
            "step_number": 7,
            "title": "",
            "step_url": "https://www.ifixit.com/Guide/How+to+Replace+Broken+Deck+Boards+on+an+Outdoor+Patio/<#s273327>",
            "instructions": [
                "Mark up screws position on each new boards.",
                "Line up the boards and mark the length where the screws should go.",
                "Measure the position of the screws from the edge on the old boards and mark the same position on the new boards."
            ],
            "images": [],
            "edit_url": "https://www.ifixit.com/Guide/How+to+Replace+Broken+Deck+Boards+on+an+Outdoor+Patio/</Guide/edit/137262/273327>",
