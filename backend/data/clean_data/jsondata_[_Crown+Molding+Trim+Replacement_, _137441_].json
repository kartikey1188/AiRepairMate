            "title": "",
            "step_url": "https://www.ifixit.com/Guide/How+to+Replace+Broken+Deck+Boards+on+an+Outdoor+Patio/<#s273326>",
            "instructions": [
                "Use a hand saw to cut along the marked cutting line for each new board.",
                "A circular saw is recommended to expedite the process if there are many broken deck boards to be replaced."
            ],
            "images": [],
            "edit_url": "https://www.ifixit.com/Guide/How+to+Replace+Broken+Deck+Boards+on+an+Outdoor+Patio/</Guide/edit/137262/273326>",
