    "steps": [
        {
            "step_number": 1,
            "title": "Blade",
            "content": [
                "Unplug the power cord."
            ],
            "image": "https://guide-images.cdn.ifixit.com/igi/QpCxwANv4wpHQRyR.medium",
            "images": [
                "https://guide-images.cdn.ifixit.com/igi/QpCxwANv4wpHQRyR.medium",
                "https://guide-images.cdn.ifixit.com/igi/v6JXuPtBrPtgHbDT.medium",
                "https://guide-images.cdn.ifixit.com/igi/BPQPTekcUBKBjBhw.medium"
            ],
            "images_200x150": [
                "https://guide-images.cdn.ifixit.com/igi/QpCxwANv4wpHQRyR.200x150",
                "https://guide-images.cdn.ifixit.com/igi/v6JXuPtBrPtgHbDT.200x150",
                "https://guide-images.cdn.ifixit.com/igi/BPQPTekcUBKBjBhw.200x150"
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/169610/359440",
            "comments_count": 0,
            "add_comment_url": null
        },
        {
            "step_number": 2,
            "content": [
                "Wipe off and dust the front and back grill of the fan."
            ],
            "images": [
                "https://guide-images.cdn.ifixit.com/igi/MrbsQ3FluQufOnB5.medium",
                "https://guide-images.cdn.ifixit.com/igi/UJNfRsuPEaODYMbQ.medium",
                "https://guide-images.cdn.ifixit.com/igi/xgxBeUnMGQROhWuE.medium"
            ],
            "images_200x150": [
                "https://guide-images.cdn.ifixit.com/igi/MrbsQ3FluQufOnB5.200x150",
                "https://guide-images.cdn.ifixit.com/igi/UJNfRsuPEaODYMbQ.200x150",
                "https://guide-images.cdn.ifixit.com/igi/xgxBeUnMGQROhWuE.200x150"
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/169610/359444",
            "comments_count": 0,
            "add_comment_url": null
        },
        {
            "step_number": 3,
            "content": [
                "Use the Phillips #0 screwdriver to remove four 8.8 mm screws that are marked on the back of the grill."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/169610/359443",
            "comments_count": 0,
            "add_comment_url": null
        },
        {
            "step_number": 4,
            "content": [
                "Unlatch the top of the fan to separate the grill and reveal the blade."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/169610/359446",
            "comments_count": 0,
            "add_comment_url": null
        },
        {
            "step_number": 5,
            "content": [
                "Grab both sides of the blade and twist counter clockwise to remove it from the base axel attached to the back grill.",
                "Depending on the age of your fan, it may require more strength to pull it out. Be careful to not use too much force."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/169610/359447",
            "comments_count": 0,
            "add_comment_url": null
        },
        {
            "step_number": 6,
            "content": [
                "Take the motor out."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/140770/282314",
            "comments_count": 0,
            "add_comment_url": null
        },
        {
            "step_number": 7,
            "content": [
                "Clean all parts of the fan."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/140770/281201",
            "comments_count": 0,
            "add_comment_url": null
        },
        {
            "step_number": 8,
            "content": [
                "Put the motor and back cover back on.",
                "This can be done by following steps 2, 3, and 5 in reverse."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/140770/281202",
            "comments_count": 0,
            "add_comment_url": null
        },
        {
            "step_number": 9,
            "content": [
                "Place the new blade onto the metal rod on the front of the fan.",
                "Push the blades onto the rod so that it is sturdy.",
                "Replace the front cover."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/140770/281204",
            "comments_count": 0,
            "add_comment_url": null
        }
    ],
    "conclusion": "To reassemble your device, follow these instructions in reverse order.",
