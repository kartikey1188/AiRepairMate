    "steps": [
        {
            "step_number": 1,
            "title": "Filter",
            "instructions": [
                "Locate the water filter in your home.",
                "The water filter is typically by where the water comes into the house."
            ],
            "image_url": "https://guide-images.cdn.ifixit.com/igi/whR3HTua1ybTlfFM.medium",
            "edit_url": "https://www.ifixit.com/Guide/edit/174331/371306",
            "add_comment_url": "https://www.ifixit.com/Guide/Aquasana+F-300R+300000+Gallon+Whole+House+Water+Filtration+System+20-Inch+Sediment+Pre-Filter+Replacement/#",
            "links": []
        },
        {
            "step_number": 2,
            "instructions": [
                "Rotate the lever near the water filter up to turn off the water to the house.",
                "This may differ depending on your setup."
            ],
            "image_url": "https://guide-images.cdn.ifixit.com/igi/HjMobcWlff2j1hly.medium",
            "additional_images": [
                "https://guide-images.cdn.ifixit.com/igi/HjMobcWlff2j1hly.200x150",
                "https://guide-images.cdn.ifixit.com/igi/hk3xwKFYtTUANAko.200x150"
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/174331/371308",
            "add_comment_url": "https://www.ifixit.com/Guide/Aquasana+F-300R+300000+Gallon+Whole+House+Water+Filtration+System+20-Inch+Sediment+Pre-Filter+Replacement/#",
            "links": []
        },
        {
            "step_number": 3,
            "instructions": [
                "Turn on a faucet inside the house to drain the water out of the pipes.",
                "Leave the faucet on until no more water comes out."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/174331/371310",
            "add_comment_url": "https://www.ifixit.com/Guide/Aquasana+F-300R+300000+Gallon+Whole+House+Water+Filtration+System+20-Inch+Sediment+Pre-Filter+Replacement/#",
            "links": []
        },
        {
            "step_number": 4,
            "instructions": [
                "Place a bucket under the filter."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/174331/371309",
            "add_comment_url": "https://www.ifixit.com/Guide/Aquasana+F-300R+300000+Gallon+Whole+House+Water+Filtration+System+20-Inch+Sediment+Pre-Filter+Replacement/#",
            "links": []
        },
        {
            "step_number": 5,
            "instructions": [
                "Press the button on top of the device for approximately 10-15 seconds until all of the water is drained."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/174331/371311",
            "add_comment_url": "https://www.ifixit.com/Guide/Aquasana+F-300R+300000+Gallon+Whole+House+Water+Filtration+System+20-Inch+Sediment+Pre-Filter+Replacement/#",
            "links": []
        },
        {
            "step_number": 6,
            "instructions": [
                "Hold the top of the device and the pipes steady and rotate the clear part of the filter to the left to remove it.",
                "Using excessive force may damage your pipes.",
                "If the filter housing is stuck, use a strap wrench to loosen the filter.",
                "Loop the strap around the filter and place the remaining strap into the slot in the wrench.",
                "Ensure the handle of the wrench is close to the filter container and that there is no slack in the strap.",
                "Grip the handle firmly to hold the strap in place.",
                "Twist to the left to unscrew the filter housing."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/174331/371312",
            "add_comment_url": "https://www.ifixit.com/Guide/Aquasana+F-300R+300000+Gallon+Whole+House+Water+Filtration+System+20-Inch+Sediment+Pre-Filter+Replacement/#",
            "links": []
        },
        {
            "step_number": 7,
            "instructions": [
                "Remove the filter from the plastic housing.",
                "Pour out the remaining water into the bucket."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/174331/371313",
            "add_comment_url": "https://www.ifixit.com/Guide/Aquasana+F-300R+300000+Gallon+Whole+House+Water+Filtration+System+20-Inch+Sediment+Pre-Filter+Replacement/#",
            "links": []
        },
        {
            "step_number": 8,
            "instructions": [
                "Use a paper towel to wipe sediment out of the filter housing and the gasket."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/174331/371314",
            "add_comment_url": "https://www.ifixit.com/Guide/Aquasana+F-300R+300000+Gallon+Whole+House+Water+Filtration+System+20-Inch+Sediment+Pre-Filter+Replacement/#",
            "links": []
        },
        {
            "step_number": 9,
            "instructions": [
                "Inspect the gasket to see if it has visible damage or dirt.",
                "If the gasket is dirty of damaged, the device may leak when reassembled.",
                "Clean any dirt off the rubber ring.",
                "If the rubber ring is damaged, replace it with a new gasket."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/174331/371315",
            "add_comment_url": "https://www.ifixit.com/Guide/Aquasana+F-300R+300000+Gallon+Whole+House+Water+Filtration+System+20-Inch+Sediment+Pre-Filter+Replacement/#",
            "links": []
        },
        {
            "step_number": 10,
            "instructions": [
                "Place the new pre-filter in the center of the filter housing canister."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/174331/371316",
            "add_comment_url": "https://www.ifixit.com/Guide/Aquasana+F-300R+300000+Gallon+Whole+House+Water+Filtration+System+20-Inch+Sediment+Pre-Filter+Replacement/#",
            "links": []
        },
        {
            "step_number": 11,
            "instructions": [
                "Screw the filter housing back on.",
                "The filter must be straight and centered in the housing."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/174331/371317",
            "add_comment_url": "https://www.ifixit.com/Guide/Aquasana+F-300R+300000+Gallon+Whole+House+Water+Filtration+System+20-Inch+Sediment+Pre-Filter+Replacement/#",
            "links": []
        },
        {
            "step_number": 12,
            "instructions": [
                "Turn the water to the house back on.",
                "Once unit is filled with water, inspect the filter to ensure there is no leakage."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/174331/371319",
            "add_comment_url": "https://www.ifixit.com/Guide/Aquasana+F-300R+300000+Gallon+Whole+House+Water+Filtration+System+20-Inch+Sediment+Pre-Filter+Replacement/#",
            "links": []
        },
        {
            "step_number": 13,
            "instructions": [
                "Run water in a sink or tub for 1-2 minutes to flush out the system and remove any air in the pipes."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/174331/371338",
            "add_comment_url": "https://www.ifixit.com/Guide/Aquasana+F-300R+300000+Gallon+Whole+House+Water+Filtration+System+20-Inch+Sediment+Pre-Filter+Replacement/#",
            "links": []
        }
    ],
