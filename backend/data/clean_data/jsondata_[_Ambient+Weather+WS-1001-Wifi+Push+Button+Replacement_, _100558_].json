    "steps": [
        {
            "step_number": 1,
            "title": "Power Button",
            "text": "Flip your device over so the back panel faces you. You should see a hole containing a screw in each corner of the device.\nInsert a 4-inch Phillips #1 screwdriver into each hole until connected with the 20 millimeter, sharp-point screw.",
            "image": "https://guide-images.cdn.ifixit.com/igi/PRkVAGrtRwanBvCK.medium",
            "image_links": [],
            "edit_link": "https://www.ifixit.com/Guide/edit/100558/158034",
            "comment_links": []
        },
        {
            "step_number": 2,
            "title": "",
            "text": "Find the power switch, located inside the heater on the bottom left corner.",
            "image": "https://guide-images.cdn.ifixit.com/igi/WTa1fSaPiSKScSRj.medium",
            "image_links": [],
            "edit_link": "https://www.ifixit.com/Guide/edit/100558/158035",
            "comment_links": []
        },
        {
            "step_number": 3,
            "title": "",
            "text": "Using a Phillips #1 screwdriver, unscrew the two 7 millimeter screws attaching the power switch to the power button.",
            "image_links": [],
            "edit_link": "https://www.ifixit.com/Guide/edit/100558/158036",
            "comment_links": []
        },
        {
            "step_number": 4,
            "title": "",
            "text": "Find the clips holding the power button in place.\nPress down on the clips to remove the button.",
            "image_links": [],
            "edit_link": "https://www.ifixit.com/Guide/edit/100558/158038",
            "comment_links": []
        },
        {
            "step_number": 5,
            "title": "",
            "text": "Slide out the new power button and plug it into the device",
            "image_links": [],
            "edit_link": "https://www.ifixit.com/Guide/edit/100558/158083",
            "comment_links": []
        }
    ],
    "conclusion": {
        "text": "To reassemble your device, follow these instructions in reverse order.",
