    "steps": [
        {
            "step_number": 1,
            "title": "Battery",
            "text": "Remove the battery compartment lid by lifting upward.",
            "image": "https://guide-images.cdn.ifixit.com/igi/ZNsNxWNdq2HbfSGU.medium",
            "image_links": [
                "https://guide-images.cdn.ifixit.com/igi/ZNsNxWNdq2HbfSGU.200x150",
                "https://guide-images.cdn.ifixit.com/igi/vD6w2suZwYLiK5Xb.200x150",
                "https://guide-images.cdn.ifixit.com/igi/TOoRScvG6KuJ452O.200x150"
            ],
            "edit_link": "https://www.ifixit.com/Guide/edit/72155/143974",
            "comment_links": [],
            "additional_images": [
                "https://guide-images.cdn.ifixit.com/igi/vD6w2suZwYLiK5Xb.medium",
                "https://guide-images.cdn.ifixit.com/igi/TOoRScvG6KuJ452O.medium"
            ]
        },
        {
            "step_number": 2,
            "title": "",
            "text": "Pull the ribbon to eject the 2 X AA alkaline batteries.",
            "image": "https://guide-images.cdn.ifixit.com/igi/aZgwxARfltbU1Wi5.medium",
            "image_links": [],
            "edit_link": "https://www.ifixit.com/Guide/edit/72155/143976",
            "comment_links": []
        },
        {
            "step_number": 3,
            "title": "",
            "text": "Once the batteries are removed, it is safe to proceed.",
            "image_links": [],
            "edit_link": "https://www.ifixit.com/Guide/edit/72155/143980",
            "comment_links": []
        },
        {
            "step_number": 4,
            "title": "Wind Vane",
            "text": "Firmly grasp the windvane with one hand and the rest of the device with the other hand.\nPull straight outwards. A quick yank with force should be enough to remove the propeller.",
            "image_links": [],
            "edit_link": "https://www.ifixit.com/Guide/edit/72155/144044",
            "comment_links": []
        },
        {
            "step_number": 5,
            "title": "",
            "text": "To reattach the replacement wind vane, line up the small notch in the socket where the pieces fit together then carefully push the parts together.",
            "image_links": [],
            "edit_link": "https://www.ifixit.com/Guide/edit/72155/144045",
            "comment_links": []
        }
    ],
    "conclusion": {
        "text": "To reassemble your device, follow these instructions in reverse order.",
