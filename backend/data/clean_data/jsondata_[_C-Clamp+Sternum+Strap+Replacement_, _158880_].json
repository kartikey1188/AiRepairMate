            ],
            "thumbnails": [
                "https://guide-images.cdn.ifixit.com/igi/HicLWQZAF2YH2RZL.200x150",
                "https://guide-images.cdn.ifixit.com/igi/moMNK5wCA5wAq6sg.200x150",
                "https://guide-images.cdn.ifixit.com/igi/lC3EhWfV22g6hpGn.200x150"
            ],
            "edit_link": "https://www.ifixit.com/Guide/C-Clamp+Sternum+Strap+Replacement/</Guide/edit/158880/333198>",
            "add_comment_link": "https://www.ifixit.com/Guide/C-Clamp+Sternum+Strap+Replacement/<#comment>"
        },
        {
            "step_number": 3,
            "instruction": [
                "Slide the Sternum Strap to your desired position.",
                "Hit the trails with your newly attached Sternum Strap!"
            ],
            "edit_link": "https://www.ifixit.com/Guide/C-Clamp+Sternum+Strap+Replacement/</Guide/edit/158880/333222>",
