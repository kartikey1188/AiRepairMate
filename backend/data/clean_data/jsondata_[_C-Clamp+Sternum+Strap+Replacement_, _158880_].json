    "steps": [
        {
            "step_number": 1,
            "title": "C-Clamp Sternum Strap Replacement",
            "instruction": [
                "Locate a proper Sternum Strap replacement. Reach out to Patagonia if you need a replacement."
            ],
            "image_urls": [
                "https://guide-images.cdn.ifixit.com/igi/MZtvTPj3PPhXhDQU.medium",
                "https://guide-images.cdn.ifixit.com/igi/1OOOdvSZQLk6SwhH.medium"
            ],
            "thumbnails": [
                "https://guide-images.cdn.ifixit.com/igi/MZtvTPj3PPhXhDQU.200x150",
                "https://guide-images.cdn.ifixit.com/igi/1OOOdvSZQLk6SwhH.200x150"
            ],
            "edit_link": "https://www.ifixit.com/Guide/C-Clamp+Sternum+Strap+Replacement/</Guide/edit/158880/333197>",
            "add_comment_link": "https://www.ifixit.com/Guide/C-Clamp+Sternum+Strap+Replacement/<#comment>"
        },
        {
            "step_number": 2,
            "instruction": [
                "At the bottom of the Sternum Strap \"Rail\" there is a flap.",
                "Pull this flap back to expose the bottom of the Rail.",
                "Slide the C-Clamp Clip back onto the Rail.",
                "The C-Clamp can be difficult to slide on. You can pull the fabric that is around the Rail tightly to make this step easier.",
                "Repeat the steps above on the other backpack strap."
            ],
            "image_urls": [
                "https://guide-images.cdn.ifixit.com/igi/HicLWQZAF2YH2RZL.medium",
                "https://guide-images.cdn.ifixit.com/igi/moMNK5wCA5wAq6sg.medium",
