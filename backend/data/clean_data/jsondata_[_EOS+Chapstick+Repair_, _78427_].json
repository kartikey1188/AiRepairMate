    "steps": [
        {
            "step_number": 1,
            "title": "EOS Chapstick Repair",
            "step_id": "s156695",
            "image_url": "https://guide-images.cdn.ifixit.com/igi/MheUvPLMtY2CKWxy.medium",
            "image_alt_text": "EOS Chapstick Repair, EOS Chapstick Repair: step 1, image 1 of 1",
            "instructions": [
                "Open your broken/melted EOS chapstick."
            ],
            "links": {
                "edit_step_link": "https://www.ifixit.com/Guide/edit/78427/156695"
            }
        },
        {
            "step_number": 2,
            "title": "",
            "step_id": "s156697",
            "image_url": "https://guide-images.cdn.ifixit.com/igi/eb63txWKDV6n2jlY.medium",
            "image_alt_text": "EOS Chapstick Repair: step 2, image 1 of 1",
            "instructions": [
                "Use a spudger to scrape out the chap stick pieces.",
                "Pry out the middle divider."
            ],
            "links": {
                "edit_step_link": "https://www.ifixit.com/Guide/edit/78427/156697"
            }
        },
        {
            "step_number": 3,
            "title": "",
            "step_id": "s156698",
            "instructions": [
                "Place the chapstick pieces into a microwavable bowl."
            ],
            "links": {
                "edit_step_link": "https://www.ifixit.com/Guide/edit/78427/156698"
            }
        },
        {
            "step_number": 4,
            "title": "",
            "step_id": "s156700",
            "instructions": [
                "Melt the chap stick pieces in a microwave for 30 second increments or until completely liquid.",
                "CAUTION: the heated liquid may be hot to the touch."
            ],
            "links": {
                "edit_step_link": "https://www.ifixit.com/Guide/edit/78427/156700"
            }
        },
        {
            "step_number": 5,
            "title": "",
            "step_id": "s156701",
            "instructions": [
                "Pour the liquid chapstick into the top of the EOS container and screw on the divider."
            ],
            "links": {
                "edit_step_link": "https://www.ifixit.com/Guide/edit/78427/156701"
            }
        },
        {
            "step_number": 6,
            "title": "",
            "step_id": "s156702",
            "instructions": [
                "Freeze the liquid in the EOS container for 20-30 minutes or until solid."
            ],
            "links": {
                "edit_step_link": "https://www.ifixit.com/Guide/edit/78427/156702"
            }
        },
        {
            "step_number": 7,
            "title": "",
            "step_id": "s156704",
            "instructions": [
                "Screw the EOS container back together and enjoy your chapstick!"
            ],
            "links": {
                "edit_step_link": "https://www.ifixit.com/Guide/edit/78427/156704"
            }
        }
    ],
    "conclusion": "To reassemble your device, follow these instructions in reverse order.",
