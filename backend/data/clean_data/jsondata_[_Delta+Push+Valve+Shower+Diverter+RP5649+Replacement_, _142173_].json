    "steps": [
        {
            "step_number": 1,
            "title": "Delta Push Valve Shower Diverter",
            "instructions": [
                "Remove the decorative cap off of the knob by pushing a flathead screwdriver underneath the cap.",
                "For this step, you can use anything that can get into the seam, such as metal spudger."
            ],
            "image_url": "https://guide-images.cdn.ifixit.com/igi/QuDityYZRGXbDoXE.medium",
            "edit_url": "https://www.ifixit.com/Guide/edit/142173/285707",
            "add_comment_url": "https://www.ifixit.com/Guide/Delta+Push+Valve+Shower+Diverter+RP5649+Replacement/#",
            "links": []
        },
        {
            "step_number": 2,
            "instructions": [
                "With a Phillips #2 screwdriver, remove the screw inside of the knob. Pull to remove the shower knob.",
                "Keep track of this screw to ensure that it does not get lost."
            ],
            "image_url": "https://guide-images.cdn.ifixit.com/igi/WJbgBJABD6k1wN5j.medium",
            "additional_images": [
                "https://guide-images.cdn.ifixit.com/igi/WJbgBJABD6k1wN5j.200x150",
                "https://guide-images.cdn.ifixit.com/igi/yEiWPXl3ucKYPZkv.200x150",
                "https://guide-images.cdn.ifixit.com/igi/jAURL5UDYAdqEctk.200x150"
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/142173/285708",
            "add_comment_url": "https://www.ifixit.com/Guide/Delta+Push+Valve+Shower+Diverter+RP5649+Replacement/#",
            "links": []
        },
        {
            "step_number": 3,
            "instructions": [
                "Using a flathead screwdriver remove the two screws holding the faceplate in place.",
                "Remember to mark where each screw went to avoid confusion when putting everything back together."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/142173/285709",
            "add_comment_url": "https://www.ifixit.com/Guide/Delta+Push+Valve+Shower+Diverter+RP5649+Replacement/#",
            "links": []
        },
        {
            "step_number": 4,
            "instructions": [
                "Use the 3/8 in. Drive 7/8 in. 6-Point SAE deep socket to remove the old diverter. Place the deep socket over the diverter and unscrew.",
                "If the diverter does not come loose with just the deep socket, you can attach a ratcheting wrench to unscrew it."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/142173/285710",
            "add_comment_url": "https://www.ifixit.com/Guide/Delta+Push+Valve+Shower+Diverter+RP5649+Replacement/#",
            "links": []
        },
        {
            "step_number": 5,
            "instructions": [
                "Insert the new diverter in place of the old one. Tighten with the deep socket or wrench.",
                "Make sure the diverter is on tight! Water will leak out from the diverter if it is not tightened properly."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/142173/285711",
            "add_comment_url": "https://www.ifixit.com/Guide/Delta+Push+Valve+Shower+Diverter+RP5649+Replacement/#",
            "links": []
        },
        {
            "step_number": 6,
            "instructions": [
                "Reassemble the faceplate and knob. Remember to place the screws back in the places they were originally.",
                "You will want to make sure the screws are properly lined up before screwing them into the face plate. Without lining them up, they will not tighten and the face plate will fall off. If this happens, push the screws in until you feel a slight _click_ into place, then screw them back in."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/142173/285712",
            "add_comment_url": "https://www.ifixit.com/Guide/Delta+Push+Valve+Shower+Diverter+RP5649+Replacement/#",
            "links": []
        }
    ],
