    "steps": [
        {
            "step_number": 1,
            "title": "Ball Catch",
            "instructions": [
                "If the bracket is still partially attached, use a screwdriver to remove the remaining screw(s), then remove the bracket from the wall completely."
            ],
            "image_url": "https://guide-images.cdn.ifixit.com/igi/NWQO2B2yLlMKoxVs.medium",
            "additional_images": [
                "https://guide-images.cdn.ifixit.com/igi/NWQO2B2yLlMKoxVs.200x150",
                "https://guide-images.cdn.ifixit.com/igi/rDe4RpU4giwMVLCP.200x150"
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/155185/323413",
            "add_comment_url": "https://www.ifixit.com/Guide/Curtain+Rod+Bracket+Replacement/#",
            "links": []
        },
        {
            "step_number": 2,
            "instructions": [
                "Observe the hole of the screw(s) that was ripped out of the wall.",
                "Determine whether the plastic anchor will fit in the current size of the hole.",
                "If the hole is smaller than the anchor, continue to Step 3. If the hole is bigger, complete this [guide](https://www.ifixit.com/Guide/Curtain+Rod+Bracket+Replacement/<https:/www.ifixit.com/Guide/Patching+a+Hole+in+Drywall/40249>) on patching a hole in dry wall."
            ],
            "image_url": "https://guide-images.cdn.ifixit.com/igi/lsX2heLRCaGf5V3X.medium",
            "additional_images": [
                "https://guide-images.cdn.ifixit.com/igi/lsX2heLRCaGf5V3X.200x150",
                "https://guide-images.cdn.ifixit.com/igi/eL2hUtFLRruyZ6Bt.200x150"
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/155185/323414",
            "add_comment_url": "https://www.ifixit.com/Guide/Curtain+Rod+Bracket+Replacement/#",
            "links": [
                {
                    "text": "guide",
                    "url": "https://www.ifixit.com/Guide/Patching+a+Hole+in+Drywall/40249"
                }
            ]
        },
        {
            "step_number": 3,
            "instructions": [
                "Use a ¼ inch drill bit to drill the hole(s) that the anchor will be placed into. Drill into the wall and continue drilling as you pull out of the wall.",
                "Avoid placing hands near the drill bit while in use. If you have medium to long-length hair, tie your hair back to avoid possible injury."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/155185/323415",
            "add_comment_url": "https://www.ifixit.com/Guide/Curtain+Rod+Bracket+Replacement/#",
            "links": []
        },
        {
            "step_number": 4,
            "instructions": [
                "Hammer the hollow wall anchor(s) into the hole until flush with the drywall."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/155185/323416",
            "add_comment_url": "https://www.ifixit.com/Guide/Curtain+Rod+Bracket+Replacement/#",
            "links": []
        },
        {
            "step_number": 5,
            "instructions": [
                "Paint the wall anchor and any surrounding area that has been damaged so that it matches the wall."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/155185/323417",
            "add_comment_url": "https://www.ifixit.com/Guide/Curtain+Rod+Bracket+Replacement/#",
            "links": []
        },
        {
            "step_number": 6,
            "instructions": [
                "Screw the bracket into the anchor(s) with a screwdriver. The bracket will be secured to the wall."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/155185/323418",
            "add_comment_url": "https://www.ifixit.com/Guide/Curtain+Rod+Bracket+Replacement/#",
            "links": []
        },
        {
            "step_number": 7,
            "instructions": [
                "Touch up with paint if necessary."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/155185/323419",
            "add_comment_url": "https://www.ifixit.com/Guide/Curtain+Rod+Bracket+Replacement/#",
            "links": []
        },
        {
            "step_number": 8,
            "instructions": [
                "Rehang your curtain rod and curtains by placing the rod onto the bracket."
            ],
            "edit_url": "https://www.ifixit.com/Guide/edit/155185/323420",
            "add_comment_url": "https://www.ifixit.com/Guide/Curtain+Rod+Bracket+Replacement/#",
            "links": []
        }
